# Database
STATUSDECK_DATABASE_PASSWORD=change_me
STATUSDECK_DATABASE_URL=postgres://statusdeck:change_me@postgres:5432/statusdeck

# Server and logging
STATUSDECK_BIND=0.0.0.0:8080
STATUSDECK_LOG_LEVEL=info
STATUSDECK_LOG_FORMAT=json

# Credentials and security
STATUSDECK_SECRET_KEY=change_me
STATUSDECK_ENCRYPTION_KEY=change_me
STATUSDECK_ADMIN_EMAIL=admin@example.com
STATUSDECK_ADMIN_PASSWORD=change_me

# Polling and retention
STATUSDECK_DEFAULT_POLL_INTERVAL=300
STATUSDECK_STALE_MULTIPLIER=3
STATUSDECK_GLOBAL_POLL_CONCURRENCY=10
STATUSDECK_PER_HOST_CONCURRENCY=2
STATUSDECK_RAW_PAYLOAD_RETENTION_DAYS=7

# Network and proxy
STATUSDECK_BASE_URL=http://localhost:8080
STATUSDECK_TRUSTED_HOSTS=localhost,127.0.0.1
STATUSDECK_SESSION_COOKIE_SECURE=false
STATUSDECK_TRUST_PROXY=true
STATUSDECK_ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
STATUSDECK_PORT=8080

# Build metadata
STATUSDECK_VERSION=0.1.0
# Set this to the exact source commit for release builds.
STATUSDECK_REVISION=development
